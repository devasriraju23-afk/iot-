# ─────────────────────────────────────────────────────────────
# Smart Door Security System — Environment Variables
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development      # set to "production" on Render / Vercel

# Session secret — change to a long, random string in production
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret

# SQLite database file path (defaults to ./security.db if not set)
DB_PATH=./security.db

# CORS — set to your frontend domain in production
# Example: https://my-smart-door.vercel.app
CORS_ORIGIN=http://localhost:3000
